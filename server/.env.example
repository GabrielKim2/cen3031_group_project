# Copy this file to server/.env and fill in real values. .env is gitignored;
# never commit real secrets.

PORT=3001

# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/collected-company

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login lasts, e.g. 1h, 1d, 7d.
JWT_EXPIRES_IN=1d
