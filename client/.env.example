# Copy this file to client/.env.local to connect the frontend to the backend.
# .env.local is gitignored; never commit real secrets here.

# "live" sends requests to the Express backend. "mock" (the default when this
# is unset) uses in-browser sample data, so the UI works without a backend.
VITE_API_MODE=live

# Where API requests go. Keep "/api" in development: Vite forwards /api to the
# backend at http://localhost:3001 (see vite.config.ts). If the backend runs on
# a different port, change the proxy target there instead of this value.
VITE_API_URL=/api
